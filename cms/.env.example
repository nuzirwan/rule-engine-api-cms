# ---------------------------------------------------------------------------
# CMS (Strapi 5) environment — DISTINCT from the Go engine's root .env.example.
# Copy to cms/.env and fill in. cms/.env is gitignored (repo-root rule).
# ---------------------------------------------------------------------------

# --- Strapi server ---------------------------------------------------------
HOST=0.0.0.0
PORT=1337

# --- Strapi secrets (generate your own; do NOT reuse these placeholders) ----
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=toBeModified
ADMIN_JWT_SECRET=toBeModified
JWT_SECRET=toBeModified
TRANSFER_TOKEN_SALT=toBeModified
ENCRYPTION_KEY=toBeModified

# ---------------------------------------------------------------------------
# CMS database — POSTGRES by default (pg driver, pinned 8.13.1).
#
# The CMS owns its OWN database and its OWN schema. It is SEPARATE from the
# rule engine's config store: the CMS never touches the engine DB directly and
# reaches engine config ONLY via the admin HTTP API (ADMIN_API_* below).
#   * Different DATABASE than the engine (engine uses e.g. `matcha`; CMS uses
#     `strapi_cms`). Same Postgres server is fine, but a separate database.
#   * Different SCHEMA than the engine (engine pins into `rule_engine`; CMS
#     pins into `strapi_cms`). The CMS must NEVER create tables in `public`
#     or in `rule_engine`.
# SQLite is NOT the default; use it only if a dev explicitly opts in locally
# by setting DATABASE_CLIENT=sqlite.
# ---------------------------------------------------------------------------
DATABASE_CLIENT=postgres

# CMS-owned Postgres connection (prefixed CMS_DB_* so it can never be confused
# with the engine's DB_* vars).
CMS_DB_HOST=localhost
CMS_DB_PORT=5432
CMS_DB_NAME=strapi_cms
CMS_DB_USER=strapi_cms
CMS_DB_PASSWORD=
CMS_DB_SSL=false
# Dedicated CMS schema — NEVER `public`, NEVER the engine's `rule_engine`.
CMS_DB_SCHEMA=strapi_cms

# Connection pool (optional)
CMS_DB_POOL_MIN=2
CMS_DB_POOL_MAX=10

# SQLite opt-in only (DATABASE_CLIENT=sqlite). Ignored under postgres.
DATABASE_FILENAME=.tmp/data.db

# ---------------------------------------------------------------------------
# Rule-engine admin HTTP API — the ONLY channel the CMS uses to read/publish
# engine config (never direct DB access). See design §3.4, §5.6.
#
# NOTE: the operator token's engine-side subject MUST be granted
#   flow.read + flow.write + flow.publish
# or publish will fail with 403 (under-privileged operator token).
# ---------------------------------------------------------------------------
# Base URL of the engine admin API (per environment; cross-env selection is by
# base URL + operator token).
ADMIN_API_BASE_URL=http://localhost:8080
# Bearer token sent as `Authorization: Bearer <token>` on every admin call.
ADMIN_API_OPERATOR_TOKEN=
# payloadEnv sent in request bodies (Environment.payloadEnv). Default "" — this
# is the body `env` field, NOT the Strapi Environment name.
ADMIN_API_ENV=
