{
  "kind": "collectionType",
  "collectionName": "webhooks",
  "info": {
    "singularName": "webhook",
    "pluralName": "webhooks",
    "displayName": "Webhook",
    "description": "A webhook configuration (FEAT-004) for receiving external events from providers like Stripe, GitHub, or generic HTTP. Maps incoming payloads to flow context via `mapping` and filters events via `filter`. `secretRef` is a reference string for signature verification, never the actual secret value."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "webhookId": {
      "type": "uid",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 256
    },
    "secretRef": {
      "type": "string",
      "maxLength": 256
    },
    "provider": {
      "type": "enumeration",
      "enum": ["stripe", "github", "generic"],
      "default": "generic",
      "required": true
    },
    "flowId": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::flow.flow"
    },
    "mapping": {
      "type": "component",
      "repeatable": true,
      "component": "webhook.mapping-field"
    },
    "filter": {
      "type": "component",
      "repeatable": true,
      "component": "webhook.filter-field"
    },
    "environment": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::environment.environment"
    },
    "engineVersion": {
      "type": "integer"
    },
    "lastSyncStatus": {
      "type": "enumeration",
      "enum": ["none", "synced", "failed"],
      "default": "none"
    }
  }
}
