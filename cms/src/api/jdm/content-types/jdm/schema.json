{
  "kind": "collectionType",
  "collectionName": "jdms",
  "info": {
    "singularName": "jdm",
    "pluralName": "jdms",
    "displayName": "Jdm",
    "description": "A versioned GoRules ZEN decision graph (design §3.2), mirroring the engine's jdms + jdm_versions. `doc` is a plain json field for now; FEAT-004 repoints it to the rule-engine.jdm-editor custom field."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "jdmId": {
      "type": "uid",
      "required": true
    },
    "doc": {
      "type": "json"
    },
    "environment": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::environment.environment"
    },
    "note": {
      "type": "text"
    },
    "engineVersion": {
      "type": "integer"
    }
  }
}
