{
  "kind": "collectionType",
  "collectionName": "connections",
  "info": {
    "singularName": "connection",
    "pluralName": "connections",
    "displayName": "Connection",
    "description": "A typed pointer at a DB/REST source (design §3.3), mirroring the engine's connections + connection_versions. Holds a `secretRef` (a reference, never a secret value); `settings` is the credential-free discrete driver shape by type. NEVER a dsn."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "key": {
      "type": "uid",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": ["postgres", "valkey", "rest", "mysql", "http", "kafka", "rabbitmq"],
      "required": true
    },
    "settings": {
      "type": "dynamiczone",
      "components": [
        "connection.postgres-settings",
        "connection.rest-settings",
        "connection.valkey-settings",
        "connection.mysql-settings",
        "connection.kafka-settings",
        "connection.rabbitmq-settings"
      ]
    },
    "secretRef": {
      "type": "string",
      "maxLength": 256
    },
    "secretRefs": {
      "type": "json"
    },
    "resilience": {
      "type": "component",
      "repeatable": false,
      "component": "connection.resilience-policy"
    },
    "environment": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::environment.environment"
    },
    "engineVersion": {
      "type": "integer"
    },
    "groups": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::group.group",
      "mappedBy": "connections"
    }
  }
}
