{
  "name": "rule-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Rule-engine control-plane plugin: visual flow-canvas + jdm-editor custom fields, validation surfacing, and the publish pipeline to the engine admin HTTP API.",
  "strapi": {
    "name": "rule-engine",
    "displayName": "Rule Engine",
    "description": "Author engine config (Flow/Jdm/Connection) and publish it via the admin HTTP API.",
    "kind": "plugin"
  },
  "scripts": {
    "build:server": "tsc -p server/tsconfig.build.json"
  },
  "exports": {
    "./strapi-admin": {
      "types": "./admin/src/index.tsx",
      "source": "./admin/src/index.tsx",
      "import": "./admin/src/index.tsx",
      "default": "./admin/src/index.tsx"
    },
    "./strapi-server": {
      "types": "./server/src/index.ts",
      "source": "./server/src/index.ts",
      "import": "./server/dist/src/plugins/rule-engine/server/src/index.js",
      "require": "./server/dist/src/plugins/rule-engine/server/src/index.js",
      "default": "./server/dist/src/plugins/rule-engine/server/src/index.js"
    }
  }
}
