{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2021"],
    "target": "ES2021",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "outDir": "./dist"
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./tests/**", "**/*.test.ts", "./dist/**"]
}
