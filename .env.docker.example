# ===========================================================================
# nzr-rules-engine Docker Compose Environment Variables
#
# Copy to .env.docker and fill in your values:
#   cp .env.docker.example .env.docker
#
# Then run:
#   docker-compose --env-file .env.docker up -d
#
# IMPORTANT: Generate your own secrets — do NOT use these placeholders!
# ===========================================================================

# ---------------------------------------------------------------------------
# Image Tags
# ---------------------------------------------------------------------------
ENGINE_TAG=latest
CMS_TAG=latest

# ---------------------------------------------------------------------------
# Exposed Ports (host:container)
# ---------------------------------------------------------------------------
ENGINE_PORT=8080
CMS_PORT=1337

# ---------------------------------------------------------------------------
# Engine Config Store (Postgres)
# ---------------------------------------------------------------------------
ENGINE_DB_NAME=rule_engine
ENGINE_DB_USER=rule_engine
ENGINE_DB_PASSWORD=CHANGEME_engine_db_password
ENGINE_CONFIG_SCHEMA=rule_engine

# ---------------------------------------------------------------------------
# Engine Admin Control Plane
#
# ADMIN_TOKENS format: ';'-separated entries of <sha256hex>:<subject>:<roles>
# Example: <sha256>:op:strapi:flow.read,flow.write,flow.publish
#
# To generate a token hash:
#   echo -n 'your-secret-token' | sha256sum | cut -d' ' -f1
# ---------------------------------------------------------------------------
ADMIN_ENABLED=true
ADMIN_TOKENS=

# ---------------------------------------------------------------------------
# Engine Data Plane Connections (optional — for flow endpoints)
# ---------------------------------------------------------------------------
ORDERS_PG_DSN=
SHIP_REST_BASE_URL=

# ---------------------------------------------------------------------------
# CMS Strapi Secrets (REQUIRED — generate your own)
#
# Generate secrets:
#   openssl rand -base64 32
#   openssl rand -hex 32
#
# APP_KEYS: comma-separated list of at least 2 keys
# ---------------------------------------------------------------------------
CMS_APP_KEYS=CHANGEME_key1,CHANGEME_key2
CMS_API_TOKEN_SALT=CHANGEME_api_token_salt
CMS_ADMIN_JWT_SECRET=CHANGEME_admin_jwt_secret
CMS_JWT_SECRET=CHANGEME_jwt_secret
CMS_TRANSFER_TOKEN_SALT=CHANGEME_transfer_token_salt
CMS_ENCRYPTION_KEY=CHANGEME_encryption_key_32chars

# ---------------------------------------------------------------------------
# CMS Database (Postgres — separate from engine)
# ---------------------------------------------------------------------------
CMS_DB_NAME=strapi_cms
CMS_DB_USER=strapi_cms
CMS_DB_PASSWORD=CHANGEME_cms_db_password
CMS_DB_SCHEMA=strapi_cms

# ---------------------------------------------------------------------------
# CMS → Engine Admin API Connection
#
# The token must be granted: flow.read, flow.write, flow.publish
# Generate a token, add its SHA-256 to ADMIN_TOKENS above, use plaintext here.
# ---------------------------------------------------------------------------
CMS_ADMIN_API_OPERATOR_TOKEN=
CMS_ADMIN_API_ENV=
