# nzr-rules-engine — local run config (template).
# Copy to .env and fill in your real values. .env is gitignored (never committed).
# The engine reads this file at startup (via the -env flag, default ".env").
# Process environment wins: a variable already set in your shell is NOT
# overridden by this file.

# =============================================================================
# Config store — THIS engine's OWN backing store (where it writes flows / JDMs /
# connection defs + versions). This is the control-plane store, NOT the data the
# flow reads.
# =============================================================================

# Full Postgres DSN for the config store. Leave EMPTY to run in-memory (no DB
# touched) — the engine then seeds seed.json into an in-process memStore.
# When set, the engine connects here, creates CONFIG_SCHEMA, applies migrations
# into it, seeds the flow config idempotently, and serves from Postgres.
# Example: postgres://user:password@127.0.0.1:5432/rule_engine?sslmode=disable
CONFIG_DSN=

# Dedicated Postgres schema the config tables live in (isolated from public and
# from your application data). Must be a plain SQL identifier
# ([A-Za-z_][A-Za-z0-9_]*). Defaults to rule_engine when unset.
CONFIG_SCHEMA=rule_engine

# Valkey address = the config CACHE (used only in config-store mode). Leave EMPTY
# to run the config store cache-down (every read hits Postgres directly). The
# in-memory mode never uses Valkey.
# Example: 127.0.0.1:6379
VALKEY_ADDR=

# =============================================================================
# HTTP edge
# =============================================================================

# Listen address for the engine's HTTP server. Overrides the -addr flag default.
ENGINE_ADDR=:8080

# =============================================================================
# Data plane — these override the seed.json connection endpoints so the flow can
# read/write YOUR running Postgres / REST without editing the seed.
# (Loaded + documented here; full auto-wiring of these in cmd/engine is a later
# increment — the integration test proves end-to-end serving with overrides.)
# =============================================================================

# Postgres the flow reads order rows from (connection key "orders-pg").
# Example: postgres://user:password@127.0.0.1:5432/orders?sslmode=disable
ORDERS_PG_DSN=

# Base URL the flow POSTs /expedite or /standard to (connection key "ship-rest").
# Example: http://127.0.0.1:8899
SHIP_REST_BASE_URL=

# Optional local REST stub that answers /expedite and /standard. Set to "1" to
# run it on REST_STUB_PORT (should match SHIP_REST_BASE_URL's port).
RUN_REST_STUB=
REST_STUB_PORT=8899
